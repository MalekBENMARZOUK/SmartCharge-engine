{
  "metadata": {
    "scenario_name": "v2g_dispatch_example",
    "description": "Single-site scenario demonstrating profitable vehicle-to-grid export."
  },
  "site": {
    "site_id": "v2g-depot",
    "time_step_minutes": 60,
    "horizon_slots": 4,
    "power_limit_kw": [50, 50, 50, 50],
    "electricity_price_per_kwh": [0.08, 0.08, 0.08, 0.08],
